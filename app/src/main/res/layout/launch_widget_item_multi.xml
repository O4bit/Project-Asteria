<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launch_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/launch_widget_slot_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/launch_multi_image"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="Mission image"
        android:scaleType="centerCrop"
        android:src="@drawable/launch_widget_photo_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/launch_multi_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Artemis II • Crewed Lunar Flyby"
            android:textColor="@color/m3e_widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launch_multi_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NASA • Kennedy LC-39B"
            android:textColor="@color/m3e_widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/launch_multi_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/launch_widget_pill_bg"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="T- 04d 12h"
        android:textColor="@color/m3e_widget_on_primary_container"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
