<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launch_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/launch_widget_slot_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/launch_single_image"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:contentDescription="Mission image"
        android:scaleType="centerCrop"
        android:src="@drawable/launch_widget_photo_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/launch_single_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Artemis II • Lunar Flyby"
            android:textColor="@color/m3e_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launch_single_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NASA • Kennedy LC-39B"
            android:textColor="@color/m3e_widget_on_surface_variant"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/launch_single_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/launch_widget_pill_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="T- 04d 12h 30m"
                android:textColor="@color/m3e_widget_on_primary_container"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launch_single_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/launch_widget_status_pill_bg"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Go"
                android:textColor="@color/m3e_widget_on_tertiary_container"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/launch_single_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Oct 21, 2026 • 18:00 UTC"
            android:textColor="@color/m3e_widget_on_surface_variant"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
