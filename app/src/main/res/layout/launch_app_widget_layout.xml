<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launch_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_widget_background"
    android:clipToOutline="true"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/launch_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/launch_widget_icon_bg"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_rocket_launch_24" />

            <TextView
                android:id="@+id/launch_widget_header_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Launches"
                android:textColor="@color/m3e_widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launch_widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/launch_widget_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="2 Selected"
                android:textColor="@color/m3e_widget_on_secondary_container"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/launch_widget_btn_configure"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/launch_widget_btn_bg"
                android:contentDescription="Select launches for widget"
                android:padding="6dp"
                android:src="@drawable/ic_tune_24" />

            <ImageView
                android:id="@+id/launch_widget_btn_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/launch_widget_btn_bg"
                android:contentDescription="Refresh launch widget"
                android:padding="5dp"
                android:src="@drawable/ic_refresh_24" />
        </LinearLayout>

        <ListView
            android:id="@+id/launch_widget_single_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <ListView
            android:id="@+id/launch_widget_multi_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/launch_widget_preview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/launch_widget_slot_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:src="@drawable/launch_widget_photo_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Artemis II • Crewed Lunar Flyby"
                        android:textColor="@color/m3e_widget_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="NASA • Kennedy LC-39B"
                        android:textColor="@color/m3e_widget_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/launch_widget_pill_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="T- 04d 12h"
                    android:textColor="@color/m3e_widget_on_primary_container"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:background="@drawable/launch_widget_slot_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:src="@drawable/launch_widget_photo_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Starship Flight 7 • Orbital Test"
                        android:textColor="@color/m3e_widget_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="SpaceX • Starbase Pad A"
                        android:textColor="@color/m3e_widget_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/launch_widget_pill_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="T- 11d 08h"
                    android:textColor="@color/m3e_widget_on_primary_container"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/launch_widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/launch_widget_slot_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/launch_widget_icon_bg"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_rocket_launch_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="No Launches Selected"
            android:textColor="@color/m3e_widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Tap to pick launches for this widget"
            android:textColor="@color/m3e_widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
