## This file is a template for local.properties
# Copy this file to local.properties and fill in your actual values
# 
# This file should *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.

# Location of the SDK. This is only used by Gradle.
# Replace with your actual Android SDK path
sdk.dir=C\:\\path\\to\\your\\Android\\Sdk

# Asteria backend (Rust NASA proxy) base URL.
# The app no longer talks to NASA directly — the server holds the NASA key.
# Trailing slash is required (Retrofit baseUrl convention).
asteria.api.base.url=https://your-worker.example.workers.dev/
