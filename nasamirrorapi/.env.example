# Server-side NASA API key. NEVER ship this to clients.
#
# In production (Cloudflare Workers) set it as a secret:
#     wrangler secret put NASA_API_KEY
#
# For local `wrangler dev`, you can put it in a `.dev.vars` file:
#     NASA_API_KEY=your_key_here
#
# Get a key (free, instant): https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY
